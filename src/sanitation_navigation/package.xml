<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sanitation_navigation</name>
  <version>0.1.0</version>
  <description>Navigation and chassis control nodes: mock chassis and waypoint patrol</description>
  <maintainer email="robotdog@example.com">robotdog</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>sanitation_core</exec_depend>
  <exec_depend>sanitation_interfaces</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-networkx</exec_depend>
  <exec_depend>python3-osmnx</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
